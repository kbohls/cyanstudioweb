---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const available = allProducts.filter(p => p.data.available);
const originals = available.filter(p => p.data.category === 'Originals');
const prints = available.filter(p => p.data.category === 'Prints');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Shop — Cyan Studio" description="Original cyanotype prints and limited edition reproductions." />
	</head>
	<body>
		<Header />
		<main>
			<div class="shop-header">
				<p class="page-label">Shop</p>
				<h1>The collection</h1>
				<p class="shop-intro">Original cyanotype prints and limited edition reproductions, each made by hand in Ucluelet, BC.</p>
				<div class="shop-filters">
					<a href="/shop" class="filter active">All ({available.length})</a>
					<a href="/shop/originals" class="filter">Originals ({originals.length})</a>
					<a href="/shop/prints" class="filter">Prints ({prints.length})</a>
				</div>
			</div>

			{available.length === 0 ? (
				<div class="coming-soon">
					<div class="cs-inner">
						<div class="cs-icon">◎</div>
						<h2>Products coming soon</h2>
						<p>The shop is being stocked. Check back shortly or <a href="/contact">get in touch</a> to be notified.</p>
					</div>
				</div>
			) : (
				<div class="product-grid">
					{available.map(product => (
						<a href={`/shop/${product.id}`} class="product-card">
							<div class="product-img">
								{product.data.image
									? <img src={product.data.image} alt={product.data.title} width="600" height="800" loading="lazy" decoding="async" />
									: <div class="img-placeholder"></div>
								}
							</div>
							<div class="product-info">
								<span class="product-category">{product.data.category}</span>
								<h3 class="product-title">{product.data.title}</h3>
								{product.data.dimensions && <p class="product-dims">{product.data.dimensions}</p>}
								<p class="product-price">CA${product.data.price.toFixed(2)}</p>
							</div>
						</a>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main { max-width: 960px; margin: 0 auto; padding: 3em 1.5em 5em; }
	.page-label { font-size: 0.72em; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan-mid); margin: 0 0 0.75em; }
	h1 { font-size: 2.2em; color: var(--prussian); margin: 0 0 0.5em; }
	.shop-intro { color: var(--text-muted); font-size: 0.95em; margin: 0 0 1.75em; max-width: 55ch; }
	.shop-filters { display: flex; gap: 0.5em; margin-bottom: 2.5em; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
	.filter {
		padding: 0.5em 1em; font-size: 0.82em; letter-spacing: 0.06em; text-transform: uppercase;
		color: var(--text-muted); text-decoration: none; border-bottom: 2px solid transparent;
		margin-bottom: -1px; transition: all 0.15s; white-space: nowrap;
	}
	.filter:hover { color: var(--prussian); }
	.filter.active { color: var(--prussian); border-bottom-color: var(--prussian); }

	.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5em; }
	.product-card {
		text-decoration: none; border: 1px solid var(--border); border-radius: 8px;
		overflow: hidden; transition: box-shadow 0.2s, transform 0.2s; background: white;
	}
	.product-card:hover { box-shadow: var(--box-shadow); transform: translateY(-2px); }
	.product-img { aspect-ratio: 3/4; overflow: hidden; background: var(--cyan-pale); }
	.product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; display: block; }
	.img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--cyan-pale) 0%, #d4eef2 100%); }
	.product-info { padding: 1em 1.1em 1.25em; }
	.product-category { font-size: 0.68em; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cyan-dark); display: block; margin-bottom: 0.3em; }
	.product-title { font-size: 0.95em; color: var(--prussian); margin: 0 0 0.25em; line-height: 1.3; }
	.product-dims { font-size: 0.75em; color: var(--sand-muted); margin: 0 0 0.5em; }
	.product-price { font-size: 0.9em; font-weight: 700; color: var(--prussian); margin: 0; }

	.coming-soon { background: var(--cyan-pale); border: 1px solid var(--border); border-radius: 10px; padding: 4em 2em; text-align: center; }
	.cs-inner { max-width: 360px; margin: 0 auto; }
	.cs-icon { font-size: 2.5em; color: var(--cyan-mid); margin-bottom: 0.5em; line-height: 1; }
	.coming-soon h2 { font-size: 1.2em; color: var(--prussian); margin: 0 0 0.6em; }
	.coming-soon p { font-size: 0.88em; color: var(--text-muted); line-height: 1.7; margin: 0; }
	.coming-soon a { color: var(--cyan-dark); }

	@media (max-width: 720px) {
		main { padding: 2em 1.25em 4em; }
		.product-grid { grid-template-columns: repeat(2, 1fr); gap: 1em; }
		h1 { font-size: 1.8em; }
	}
	@media (max-width: 480px) {
		main { padding: 1.5em 0.9em 3em; }
		.product-grid { gap: 0.75em; }
		.product-info { padding: 0.65em 0.75em 0.75em; }
	}
</style>
