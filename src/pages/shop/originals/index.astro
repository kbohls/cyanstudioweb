---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const products = allProducts.filter(p => p.data.available && p.data.category === 'Originals');
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Originals — Cyan Studio" description="One-of-a-kind original cyanotype prints." />
	</head>
	<body>
		<Header />
		<main>
			<p class="page-label">Shop / Originals</p>
			<h1>Originals</h1>
			<p class="shop-intro">Each original is one-of-a-kind, no two are ever the same. Created on high‑quality, acid‑free watercolour paper, every piece is hand‑coated with cyanotype sensitizer and exposed with a unique composition of seaweeds and botanicals.</p>
			<div class="back-link"><a href="/shop">← All products</a></div>
			{products.length === 0 ? (
				<div class="empty"><p>No originals available right now. <a href="/contact">Get in touch</a> to be notified.</p></div>
			) : (
				<div class="product-grid">
					{products.map(product => (
						<a href={`/shop/${product.id}`} class="product-card">
							<div class="product-img">
								{product.data.image ? <img src={product.data.image} alt={product.data.title} width="600" height="800" loading="lazy" decoding="async" /> : <div class="img-placeholder"></div>}
							</div>
							<div class="product-info">
								<h3>{product.data.title}</h3>
								{product.data.dimensions && <p class="dims">{product.data.dimensions}</p>}
								<p class="price">CA${product.data.price.toFixed(2)}</p>
							</div>
						</a>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
<style>
	main { max-width: 960px; margin: 0 auto; padding: 3em 1.5em 5em; }
	.page-label { font-size: 0.72em; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan-mid); margin: 0 0 0.75em; }
	h1 { font-size: 2.2em; color: var(--prussian); margin: 0 0 0.5em; }
	.shop-intro { color: var(--text-muted); font-size: 0.95em; margin: 0 0 0.75em; }
	.back-link { margin-bottom: 2em; } .back-link a { font-size: 0.85em; color: var(--cyan-dark); text-decoration: none; }
	.product-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5em; }
	.product-card { text-decoration: none; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; background: white; transition: box-shadow 0.2s, transform 0.2s; }
	.product-card:hover { box-shadow: var(--box-shadow); transform: translateY(-2px); }
	.product-img { aspect-ratio: 3/4; background: var(--cyan-pale); overflow: hidden; }
	.product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
	.img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--cyan-pale) 0%, #d4eef2 100%); }
	.product-info { padding: 1em 1.1em 1.25em; }
	h3 { font-size: 0.95em; color: var(--prussian); margin: 0 0 0.25em; }
	.dims { font-size: 0.75em; color: var(--sand-muted); margin: 0 0 0.4em; }
	.price { font-size: 0.9em; font-weight: 700; color: var(--prussian); margin: 0; }
	.empty { background: var(--cyan-pale); border: 1px solid var(--border); border-radius: 8px; padding: 3em; text-align: center; }
	.empty p { font-size: 0.9em; color: var(--text-muted); margin: 0; }
	.empty a { color: var(--cyan-dark); }
	@media (max-width: 720px) { .product-grid { grid-template-columns: repeat(2,1fr); } }
	@media (max-width: 480px) { .product-grid { grid-template-columns: 1fr; } }
</style>
