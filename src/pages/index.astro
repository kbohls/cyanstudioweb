---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const featured = allProducts.filter(p => p.data.available).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-text">
					<p class="hero-location">Ucluelet, BC</p>
					<h1>Impressions<br/>of nature</h1>
					<p class="hero-desc">
						Slowly made cyanotype prints, inspired by the coast and developed by the sun.
					</p>
					<div class="hero-actions">
						<a href="/shop" class="btn-primary">Browse the shop</a>
						<a href="/about" class="btn-secondary">About the process</a>
					</div>
				</div>
				<div class="hero-aside">
					<div class="process-card">
						<div class="process-step">
							<span class="step-num">01</span>
							<span>Forage coastal botanicals &amp; seaweeds</span>
						</div>
						<div class="process-step">
							<span class="step-num">02</span>
							<span>Coat archival paper with cyanotype sensitizer</span>
						</div>
						<div class="process-step">
							<span class="step-num">03</span>
							<span>Arrange composition &amp; expose to sunlight</span>
						</div>
						<div class="process-step">
							<span class="step-num">04</span>
							<span>Rinse &amp; reveal the blueprint</span>
						</div>
					</div>
				</div>
			</section>

			<section class="shop-preview">
				<div class="section-header">
					<h2>Current collection</h2>
					<a href="/shop" class="view-all">View all →</a>
				</div>

				{featured.length > 0 ? (
					<div class="product-grid">
						{featured.map(product => (
							<a href={`/shop/${product.id}`} class="product-card">
								<div class="product-img">
									{product.data.image
										? <img src={product.data.image} alt={product.data.title} />
										: <div class="img-placeholder"></div>
									}
								</div>
								<div class="product-info">
									<span class="product-category">{product.data.category}</span>
									<h3 class="product-title">{product.data.title}</h3>
									{product.data.dimensions && <p class="product-dims">{product.data.dimensions}</p>}
									<p class="product-price">CA${product.data.price.toFixed(2)}</p>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="coming-soon">
						<p>The shop is being stocked — check back shortly or <a href="/contact">get in touch</a> to be notified.</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 1.5em 4em;
	}

	/* ── Hero ── */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3em;
		align-items: center;
		padding: 4em 0 3em;
		border-bottom: 1px solid var(--border);
	}
	.hero-location {
		font-size: 0.75em;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--cyan-mid);
		margin: 0 0 0.75em;
	}
	.hero h1 {
		font-size: 3.2em;
		line-height: 1.05;
		color: var(--prussian);
		margin: 0 0 0.6em;
	}
	.hero-desc {
		font-size: 1em;
		color: var(--text-muted);
		line-height: 1.75;
		margin: 0 0 1.75em;
		max-width: 42ch;
	}
	.hero-actions {
		display: flex;
		gap: 1em;
		flex-wrap: wrap;
	}
	.btn-primary {
		background: var(--prussian);
		color: #fff;
		padding: 0.7em 1.5em;
		border-radius: 4px;
		text-decoration: none;
		font-size: 0.85em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: background 0.2s;
	}
	.btn-primary:hover { background: var(--prussian-dark); color: #fff; }
	.btn-secondary {
		color: var(--prussian);
		padding: 0.7em 1.5em;
		border-radius: 4px;
		border: 1.5px solid var(--prussian);
		text-decoration: none;
		font-size: 0.85em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: all 0.2s;
	}
	.btn-secondary:hover { background: var(--prussian); color: #fff; }

	/* ── Process card ── */
	.process-card {
		background: var(--prussian);
		border-radius: 8px;
		padding: 2em;
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}
	.process-step {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		color: rgba(255,255,255,0.8);
		font-size: 0.88em;
		line-height: 1.5;
	}
	.step-num {
		font-size: 0.7em;
		letter-spacing: 0.1em;
		color: var(--cyan-light);
		padding-top: 0.2em;
		flex-shrink: 0;
	}

	/* ── Shop preview ── */
	.shop-preview { padding: 3em 0; }
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.5em;
	}
	.section-header h2 {
		font-size: 1.4em;
		color: var(--prussian);
		margin: 0;
	}
	.view-all {
		font-size: 0.85em;
		color: var(--cyan-dark);
		text-decoration: none;
		letter-spacing: 0.04em;
	}
	.view-all:hover { color: var(--prussian); }

	.product-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}
	.product-card {
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		transition: box-shadow 0.2s, transform 0.2s;
		background: white;
	}
	.product-card:hover {
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.product-img {
		aspect-ratio: 3/4;
		overflow: hidden;
		background: var(--cyan-pale);
	}
	.product-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.img-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--cyan-pale) 0%, #cde3ef 100%);
	}
	.product-info { padding: 1em 1.1em 1.25em; }
	.product-category {
		font-size: 0.68em;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cyan-dark);
		display: block;
		margin-bottom: 0.3em;
	}
	.product-title {
		font-size: 0.95em;
		color: var(--prussian);
		margin: 0 0 0.25em;
		line-height: 1.3;
	}
	.product-dims { font-size: 0.75em; color: var(--sand-muted); margin: 0 0 0.5em; }
	.product-price { font-size: 0.9em; font-weight: 700; color: var(--prussian); margin: 0; }

	.coming-soon {
		background: var(--cyan-pale);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 2.5em;
		text-align: center;
	}
	.coming-soon p { font-size: 0.9em; color: var(--text-muted); margin: 0; }
	.coming-soon a { color: var(--cyan-dark); }

	@media (max-width: 720px) {
		.hero { grid-template-columns: 1fr; gap: 2em; padding: 2.5em 0 2em; }
		.hero h1 { font-size: 2.4em; }
		.product-grid { grid-template-columns: 1fr 1fr; }
	}
	@media (max-width: 480px) {
		.product-grid { grid-template-columns: 1fr; }
	}
</style>
