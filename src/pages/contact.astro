---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact — Cyan Studio" description="Get in touch with Cyan Studio." />
	</head>
	<body>
		<Header />
		<main>
			<p class="page-label">Contact</p>
			<h1>Get in touch!</h1>
			<p class="intro">Questions about a piece, the process, custom orders, or workshop enquiries? I'd love to hear from you.</p>

			<div class="contact-grid">
				<form class="contact-form" action="https://formspree.io/f/xbdqjvnv" method="POST">
					<div class="field">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required placeholder="Your name" />
					</div>
					<div class="field">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" required placeholder="your@email.com" />
					</div>
					<div class="field">
						<label for="subject">Subject</label>
						<select id="subject" name="subject">
							<option value="">Select a topic...</option>
							<option value="order">Question about an order</option>
							<option value="custom">Custom commission</option>
							<option value="wholesale">Wholesale enquiry</option>
                            <option value="workshop">Cyanotype workshop enquiry</option>
							<option value="other">Something else</option>
						</select>
					</div>
					<div class="field">
						<label for="message">Message</label>
						<textarea id="message" name="message" rows="5" required placeholder="Your message..."></textarea>
					</div>
					<button type="submit" class="submit-btn">Send message</button>
					<input type="hidden" name="_next" value="https://cyanstudio.ca/thanks" />
				</form>

				<aside class="contact-aside">
					<div class="aside-item">
						<h3>Based in</h3>
						<p>Ucluelet, BC<br/>Nuu-chah-nulth Territory<br/>Vancouver Island, Canada</p>
					</div>
					<div class="aside-item">
						<h3>Response time</h3>
						<p>I typically aim to reply within 1-2 business days, but am occasionally away for fieldwork so appreciate your patience.</p>
					</div>
					<div class="aside-item">
						<h3>Custom commissions</h3>
						<p>Interested in a custom piece using specific botanicals, a personalized photo, or for a special occasion? I'd love to collaborate.</p>
					</div>
					<div class="aside-item">
						<h3>Workshop enquiries</h3>
						<p>Interested in trying cyanotype yourself? I am equipped with a workshop kit for groups of 15-20 and love sharing the solar printing process with others.</p>
                    </div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 3em 1.5em 5em;
	}
	.page-label {
		font-size: 0.72em;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--cyan-mid);
		margin: 0 0 0.75em;
	}
	h1 {
		font-size: 2.2em;
		color: var(--prussian);
		margin: 0 0 0.4em;
	}
	.intro {
		color: var(--text-muted);
		font-size: 0.95em;
		margin: 0 0 2.5em;
	}
	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 3em;
		align-items: start;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		margin-bottom: 1.25em;
	}
	label {
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--prussian);
	}
	input, select, textarea {
		font-family: inherit;
		font-size: 0.95em;
		padding: 0.65em 0.85em;
		border: 1.5px solid var(--border);
		border-radius: 5px;
		background: white;
		color: var(--prussian);
		transition: border-color 0.15s;
		width: 100%;
		box-sizing: border-box;
	}
	input:focus, select:focus, textarea:focus {
		outline: none;
		border-color: var(--cyan-mid);
	}
	textarea { resize: vertical; }
	.submit-btn {
		background: var(--prussian);
		color: var(--sand-light);
		border: none;
		padding: 0.85em 2em;
		border-radius: 5px;
		font-family: inherit;
		font-size: 0.85em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background 0.2s;
		width: 100%;
	}
	.submit-btn:hover { background: var(--prussian-dark); }

	.contact-aside {
		display: flex;
		flex-direction: column;
		gap: 1.5em;
		padding-top: 0.25em;
	}
	.aside-item h3 {
		font-size: 0.78em;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--cyan-dark);
		margin: 0 0 0.4em;
	}
	.aside-item p {
		font-size: 0.88em;
		color: var(--text-muted);
		line-height: 1.7;
		margin: 0;
	}

	@media (max-width: 720px) {
		main { padding: 2em 1.25em 4em; }
		.contact-grid { grid-template-columns: 1fr; gap: 2em; }
		h1 { font-size: 1.8em; }
	}
	@media (max-width: 480px) {
		main { padding: 1.5em 0.9em 3em; }
		h1 { font-size: 1.5em; }
	}
</style>
