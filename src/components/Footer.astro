---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a href="/" aria-label="Cyan Studio — Home">
				<img
					src="/images/logos/CS_secondary-logo_white_rgb.svg"
					alt="Cyan Studio"
					class="footer-logo"
					width="140"
					height="65"
				/>
			</a>
			<span class="footer-location">Ucluelet, BC &nbsp;·&nbsp; Traditional Nuu-chah-nulth Territory</span>
		</div>
		<div class="footer-links">
			<a href="/shop">Shop</a>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
		</div>
	</div>
	<div class="footer-copy">
		&copy; {today.getFullYear()} Cyan Studio. All rights reserved.
	</div>
</footer>

<style>
	footer {
		padding: 2.5em 2em 2em;
		background: var(--prussian-dark);
		color: var(--sand);
	}
	.footer-inner {
		max-width: 960px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2em;
		flex-wrap: wrap;
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgba(255,255,255,0.1);
		margin-bottom: 1.25em;
	}
	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.footer-logo {
		height: 40px;
		width: auto;
		display: block;
		opacity: 0.9;
		transition: opacity 0.2s;
	}
	.footer-logo:hover { opacity: 1; }
	.footer-location {
		font-size: 0.72em;
		color: var(--sand-muted);
		letter-spacing: 0.04em;
	}
	.footer-links {
		display: flex;
		gap: 1.5em;
		align-items: center;
	}
	.footer-links a {
		color: var(--sand);
		text-decoration: none;
		font-size: 0.85em;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		transition: color 0.15s;
	}
	.footer-links a:hover { color: #ffffff; }
	.footer-copy {
		max-width: 960px;
		margin: 0 auto;
		font-size: 0.72em;
		color: var(--sand-muted);
		text-align: center;
	}
</style>
