---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="footer-title">Cyan Studio</span>
			<span class="footer-location">Ucluelet, BC &nbsp;·&nbsp; Traditional Nuu-chah-nulth Territory</span>
		</div>
		<div class="footer-links">
			<a href="/shop">Shop</a>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
		</div>
	</div>
	<div class="footer-copy">
		&copy; {today.getFullYear()} Cyan Studio. All rights reserved.
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1.5em 2em;
		background: var(--prussian-dark);
		color: var(--sand);
	}
	.footer-inner {
		max-width: 860px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2em;
		flex-wrap: wrap;
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgba(255,255,255,0.1);
		margin-bottom: 1.25em;
	}
	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.footer-title {
		font-size: 1em;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sand-light);
	}
	.footer-location {
		font-size: 0.75em;
		color: var(--sand-muted);
		letter-spacing: 0.04em;
	}
	.footer-links {
		display: flex;
		gap: 1.5em;
	}
	.footer-links a {
		color: var(--sand);
		text-decoration: none;
		font-size: 0.85em;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.footer-links a:hover {
		color: var(--sand-light);
	}
	.footer-copy {
		max-width: 860px;
		margin: 0 auto;
		font-size: 0.75em;
		color: var(--sand-muted);
		text-align: center;
	}
</style>
